# Auf dem Server nach deploy/.env kopieren und mit echten Werten befüllen.
# Diese Datei wird vom Deploy-Workflow nicht angefasst und liegt nicht im Repo.

# POSTGRES_PASSWORD landet unverschlüsselt als Teil einer URL in DATABASE_URL
# (siehe docker-compose.yml) - mit `openssl rand -hex 32` erzeugen, nicht
# -base64, da dessen Zeichen (/+=) eine Postgres-Connection-URL kaputt machen
# können (pg-connection-string wirft dann "Invalid URL").
POSTGRES_PASSWORD=
# JWT_SECRET landet in keiner URL, `openssl rand -base64 32` ist hier unproblematisch.
JWT_SECRET=

# Wird vom GitHub-Actions-Workflow bei jedem Deploy überschrieben (Git-Commit-SHA
# des neu gebauten Images) - lokal für den allerersten manuellen Start auf
# "latest" lassen.
IMAGE_TAG=latest
