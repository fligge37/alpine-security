# Auf dem Server nach deploy/.env kopieren und mit echten Werten befüllen.
# Diese Datei wird vom Deploy-Workflow nicht angefasst und liegt nicht im Repo.

# Mit z.B. `openssl rand -base64 32` erzeugen.
POSTGRES_PASSWORD=
JWT_SECRET=

# Wird vom GitHub-Actions-Workflow bei jedem Deploy überschrieben (Git-Commit-SHA
# des neu gebauten Images) - lokal für den allerersten manuellen Start auf
# "latest" lassen.
IMAGE_TAG=latest
