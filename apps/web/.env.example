# Nur relevant für die native App (Capacitor) - im Browser läuft der Vite-Proxy.
# Adresse, unter der die native App die lokale API erreicht (Simulator kann
# den Host über localhost ansprechen, ein echtes Gerät braucht die LAN-IP des
# Rechners, z.B. http://192.168.1.23:3000).
VITE_API_BASE_URL=http://localhost:3000
