# Ziel des Dev-Vite-Proxys (/api -> ...). Default ist die lokale Dev-API;
# zum Testen gegen den deployten Server hier die Server-URL eintragen, z.B.
# VITE_API_PROXY_TARGET=https://06yre4t.cserverhost.cloud
VITE_API_PROXY_TARGET=http://localhost:3000

# API-Key für die Satellitenansicht in ToursMap (MapTiler Satellite, kostenloses Kontingent
# unter https://cloud.maptiler.com). Ohne Key bleibt der Satellit-Button im Ansichts-Umschalter
# deaktiviert, 2D- und Geländeansicht funktionieren weiterhin ohne Key.
VITE_MAPTILER_KEY=
